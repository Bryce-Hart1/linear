{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "linear",
  "version": "0.1.0",
  "identifier": "io.github.bryce-hart1.linear",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "linear",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "lin"
        ],
        "name": "linear diagram",
        "description": "A diagram made in linear",
        "role": "Editor",
        "mimeType": "text/x-lin"
      },
      {
        "ext": [
          "lpx"
        ],
        "name": "linear pixel art",
        "description": "Pixel art made in linear",
        "role": "Editor",
        "mimeType": "application/x-lpx"
      },
      {
        "ext": [
          "ldw"
        ],
        "name": "linear drawing",
        "description": "A drawing made in linear",
        "role": "Editor",
        "mimeType": "application/x-ldw"
      }
    ],
    "shortDescription": "Diagrams, pixel art and drawings"
  }
}
